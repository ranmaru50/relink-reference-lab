<?xml version="1.0" encoding="UTF-8"?>
<ar-entity
  xmlns="https://relink.dev/ns/arxml/core/0.1"
  xmlns:http="https://relink.dev/ns/arxml/http/0.1"
  version="0.1">
  <category>reference-lab.controller</category>

  <subjects>
    <subject id="controller-mcu" type="https://relink.dev/subjects/controller/1" />
  </subjects>

  <profiles>
    <conforms-to href="https://relink.dev/profiles/reference-lab/controller-monitor/1" />
  </profiles>

  <interfaces>
    <interface id="pico-http-api">
      <realization>
        <http:api base="../api/" />
      </realization>
    </interface>
  </interfaces>

  <capabilities>
    <capability
      id="controller-temperature"
      type="https://relink.dev/capabilities/temperature/read/1"
      subject-ref="controller-mcu">
      <invocation>
        <result>
          <outputs>
            <output name="temperature" type="number" unit="Cel" />
          </outputs>
          <representations>
            <representation media-type="application/json" />
          </representations>
        </result>
      </invocation>
      <interface-uses>
        <interface-use ref="pico-http-api">
          <mapping>
            <http:operation method="GET" path="temperature" />
          </mapping>
        </interface-use>
      </interface-uses>
    </capability>

    <capability
      id="indicator"
      type="https://relink.dev/capabilities/indicator/set/1"
      subject-ref="controller-mcu">
      <invocation>
        <inputs>
          <input name="on" type="boolean" required="true" />
        </inputs>
        <result>
          <outputs>
            <output name="state" type="boolean" />
          </outputs>
          <representations>
            <representation media-type="application/json" />
          </representations>
        </result>
      </invocation>
      <interface-uses>
        <interface-use ref="pico-http-api">
          <mapping>
            <http:operation method="POST" path="light/state" />
          </mapping>
        </interface-use>
      </interface-uses>
    </capability>
  </capabilities>
</ar-entity>
